// SCL Phase 1 — foundational schema
// Stack: PostgreSQL + Prisma. Models cover auth, cappers, plays, parlays,
// packages, tracking, and grading. Built to be extended per feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Auth.js / NextAuth) ----------

enum Role {
  CAPPER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  passwordHash  String?
  displayName   String?
  role          Role      @default(CAPPER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  capperProfile     CapperProfile?
  termsAcceptances  TermsAcceptance[]
  gradingActions    GradingAudit[]    @relation("GradedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TermsAcceptance {
  id            String   @id @default(cuid())
  userId        String
  policyVersion String
  acceptedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Capper profile & packages ----------

enum ProviderType {
  FREE
  PREMIUM
  HYBRID
}

model CapperProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  bio         String?
  avatarUrl   String?
  specialties String[]      @default([])
  providerType ProviderType @default(FREE)
  isLegacy    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plays    Play[]
  parlays  Parlay[]
  packages Package[]

  @@index([providerType])
}

model Package {
  id           String       @id @default(cuid())
  capperId     String
  title        String
  description  String?
  priceCents   Int          @default(0)
  providerType ProviderType @default(PREMIUM)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  capper      CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  trackingUrls TrackingUrl[]

  @@index([capperId])
}

model TrackingUrl {
  id        String   @id @default(cuid())
  packageId String
  slug      String   @unique
  targetUrl String
  createdAt DateTime @default(now())

  package Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  clicks  ClickEvent[]

  @@index([packageId])
}

model ClickEvent {
  id           String   @id @default(cuid())
  trackingUrlId String
  referrer     String?
  userAgent    String?
  createdAt    DateTime @default(now())

  trackingUrl TrackingUrl @relation(fields: [trackingUrlId], references: [id], onDelete: Cascade)

  @@index([trackingUrlId])
}

// ---------- Plays, parlays & grading ----------

enum Outcome {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum GradingSource {
  AUTO
  ADMIN_OVERRIDE
  MANUAL
}

model Play {
  id         String   @id @default(cuid())
  capperId   String
  sport      String
  league     String?
  market     String
  selection  String
  oddsAmerican Int
  units      Decimal  @db.Decimal(10, 2)
  outcome    Outcome  @default(PENDING)
  profitUnits Decimal? @db.Decimal(10, 2)
  notes      String?
  parlayId   String?
  createdAt  DateTime @default(now())
  gradedAt   DateTime?

  capper CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  parlay Parlay?       @relation(fields: [parlayId], references: [id], onDelete: SetNull)
  audits GradingAudit[]

  @@index([capperId])
  @@index([outcome])
}

model Parlay {
  id           String   @id @default(cuid())
  capperId     String
  combinedOddsAmerican Int?
  units        Decimal  @db.Decimal(10, 2)
  outcome      Outcome  @default(PENDING)
  profitUnits  Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  gradedAt     DateTime?

  capper CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  legs   Play[]

  @@index([capperId])
}

model GradingAudit {
  id           String        @id @default(cuid())
  playId       String
  previousOutcome Outcome
  newOutcome   Outcome
  source       GradingSource
  gradedById   String?
  reason       String?
  createdAt    DateTime      @default(now())

  play     Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  gradedBy User? @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([playId])
}
