// SCL Phase 1 — foundational schema
// Stack: PostgreSQL + Prisma. Models cover auth, cappers, plays, parlays,
// packages, tracking, and grading. Built to be extended per feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (Auth.js / NextAuth) ----------

enum Role {
  CAPPER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                       String        @id @default(cuid())
  email                    String
  username                 String?       @unique
  passwordHash             String?
  /// Credential carried over from the previous platform, in whatever format that
  /// stack wrote it (see `src/lib/legacy-password.ts`). Verified at login, then
  /// re-hashed into `passwordHash` and cleared — so this empties out over time.
  legacyPasswordHash       String?
  /// Optional format hint for the above; detected from the hash shape when unset.
  legacyPasswordFormat     String?
  /// Set when a sign-in succeeded with a password that no longer meets the
  /// current requirements. The account still works — this only drives the
  /// update prompt and the one-time notice.
  passwordUpdateRequiredAt DateTime?
  passwordNoticeSentAt     DateTime?
  displayName              String?
  role                     Role          @default(CAPPER)
  accountStatus            AccountStatus @default(ACTIVE)
  emailVerified            DateTime?
  image                    String?
  /// When true, excluded from public leaderboard / picks / discover / profile.
  /// Toggle in Supabase without a code change; handle guards remain as backup.
  isTest                   Boolean       @default(false)
  /// Set from the unsubscribe link. Suppresses roster-wide broadcasts only —
  /// verification, password resets and direct admin messages are operational
  /// and always send.
  marketingOptOut          Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  accounts               Account[]
  sessions               Session[]
  capperProfile          CapperProfile?
  termsAcceptances       TermsAcceptance[]
  gradingActions         GradingAudit[]            @relation("GradedBy")
  parlayGradeActions     ParlayGradingAudit[]      @relation("ParlayGradedBy")
  passwordResetToken     PasswordResetToken?
  statusChanges          AccountStatusAudit[]      @relation("AccountStatusSubject")
  statusActions          AccountStatusAudit[]      @relation("AccountStatusActor")
  storefrontReviews      StorefrontReviewEvent[]   @relation("StorefrontReviewActor")
  storefrontReviewed     StoreConnection[]         @relation("StoreConnectionReviewedBy")
  policyUpdates          PolicyDocument[]          @relation("PolicyUpdatedBy")
  policyRevisions        PolicyDocumentRevision[]  @relation("PolicyRevisionEditedBy")
  emailTemplates         EmailTemplate[]           @relation("EmailTemplateUpdatedBy")
  emailTemplateEdits     EmailTemplateRevision[]   @relation("EmailTemplateRevisionEditedBy")
  emailAutomationUpdates EmailAutomationConfig[]   @relation("EmailAutomationConfigUpdatedBy")
  automatedEmails        EmailAutomationDelivery[] @relation("EmailAutomationRecipient")
  packageAudits          PackageAuditEvent[]       @relation("PackageAuditActor")
  storefrontMessages     StorefrontMessage[]       @relation("StorefrontMessageSender")
  broadcastsSent         AdminBroadcast[]          @relation("AdminBroadcastSender")
  broadcastsReceived     AdminBroadcastRecipient[] @relation("AdminBroadcastRecipientUser")
  oddsControlUpdates     OddsControlConfig[]       @relation("OddsControlUpdatedBy")
  oddsSportUpdates       OddsSportControl[]        @relation("OddsSportControlUpdatedBy")
  oddsControlAudits      OddsControlAuditEvent[]   @relation("OddsControlAuditActor")
  oddsRunsTriggered      OddsApiRun[]              @relation("OddsApiRunTriggeredBy")

  @@unique([email, username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id                       String   @id @default(cuid())
  userId                   String
  /// Stable version of the complete required-policy bundle accepted by the user.
  policyVersion            String
  termsVersion             String?
  privacyVersion           String?
  responsibleGamingVersion String?
  refundVersion            String?
  consentTextVersion       String?
  acceptanceSource         String?
  acceptedAt               DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountStatusAudit {
  id             String        @id @default(cuid())
  userId         String
  previousStatus AccountStatus
  newStatus      AccountStatus
  changedById    String
  reason         String?
  createdAt      DateTime      @default(now())

  user      User @relation("AccountStatusSubject", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User @relation("AccountStatusActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([changedById])
}

model RequestThrottle {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

// ---------- Admin-managed policy documents ----------

enum PolicySlug {
  TERMS
  PRIVACY
  DISCLAIMER
  RESPONSIBLE_GAMING
  REFUND
}

model PolicyDocument {
  slug        PolicySlug @id
  title       String
  body        String     @db.Text
  version     String
  publishedAt DateTime   @default(now())
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  updatedBy User?                    @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions PolicyDocumentRevision[]

  @@index([updatedById])
}

model PolicyDocumentRevision {
  id         String     @id @default(cuid())
  slug       PolicySlug
  title      String
  body       String     @db.Text
  version    String
  editedById String?
  createdAt  DateTime   @default(now())

  document PolicyDocument @relation(fields: [slug], references: [slug], onDelete: Cascade)
  editedBy User?          @relation("PolicyRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([slug, createdAt])
  @@index([editedById])
}

/// Owner-editable copy for capper-facing email. Slug is a plain string keyed to
/// the code registry in `src/lib/email-templates.ts` — adding a template needs a
/// sender in code anyway, so an enum would only add a migration to that work.
/// A missing row is not an error: the bundled default is the fallback.
model EmailTemplate {
  slug        String   @id
  subject     String
  body        String   @db.Text
  actionLabel String
  footnote    String   @db.Text
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User?                   @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions EmailTemplateRevision[]

  @@index([updatedById])
}

model EmailTemplateRevision {
  id          String   @id @default(cuid())
  slug        String
  subject     String
  body        String   @db.Text
  actionLabel String
  footnote    String   @db.Text
  editedById  String?
  createdAt   DateTime @default(now())

  template EmailTemplate @relation(fields: [slug], references: [slug], onDelete: Cascade)
  editedBy User?         @relation("EmailTemplateRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([slug, createdAt])
  @@index([editedById])
}

/// Owner-controlled lifecycle-email timing and safety limits. The singleton
/// row is intentionally absent until an owner saves it: missing configuration
/// means both automations are off, so a deployment can never surprise-email
/// the historical roster.
enum EmailAutomationDeliveryStatus {
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum EmailAutomationRunStatus {
  RUNNING
  SUCCEEDED
  COMPLETED_WITH_ERRORS
  FAILED
  SKIPPED
}

model EmailAutomationConfig {
  id                              String    @id @default("primary")
  verificationReminderEnabled     Boolean   @default(false)
  verificationReminderDelayHours  Int       @default(24)
  verificationReminderActivatedAt DateTime?
  noPlaysNudgeEnabled             Boolean   @default(false)
  noPlaysNudgeDelayHours          Int       @default(72)
  noPlaysNudgeActivatedAt         DateTime?
  /// Shared rolling-24-hour cap for lifecycle mail. Keeps capacity available
  /// under Resend's 100-message allowance for security mail and owner sends.
  dailyLimit                      Int       @default(25)
  updatedById                     String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  updatedBy User? @relation("EmailAutomationConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

/// One durable row per capper and automation. The compound unique constraint
/// is the duplicate-send barrier across retries, overlapping crons, and warm
/// serverless isolates.
model EmailAutomationDelivery {
  id            String                        @id @default(cuid())
  automationKey String
  userId        String
  status        EmailAutomationDeliveryStatus @default(PROCESSING)
  attemptCount  Int                           @default(1)
  claimedAt     DateTime                      @default(now())
  nextAttemptAt DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  lastError     String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  user User @relation("EmailAutomationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([automationKey, userId])
  @@index([status, nextAttemptAt])
  @@index([sentAt])
  @@index([userId])
}

/// Run history powers owner visibility and supplies a recoverable scheduler
/// lock instead of relying on in-memory state in a serverless process.
model EmailAutomationRun {
  id         String                   @id @default(cuid())
  status     EmailAutomationRunStatus @default(RUNNING)
  startedAt  DateTime                 @default(now())
  finishedAt DateTime?
  attempted  Int                      @default(0)
  sent       Int                      @default(0)
  failed     Int                      @default(0)
  skipped    Int                      @default(0)
  error      String?
  createdAt  DateTime                 @default(now())

  @@index([createdAt])
  @@index([status, startedAt])
}

model EmailAutomationLock {
  key         String   @id
  lockedBy    String?
  lockedUntil DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Short-lived delivery ledger for owner visibility. Recipient identity is a
/// snapshot rather than a relation so an account rename or deletion cannot
/// rewrite what was actually addressed. Rows are pruned after 14 days by the
/// same best-effort writer that creates them.
enum SystemEmailActivityStatus {
  SENT
  FAILED
}

model SystemEmailActivity {
  id                String                    @id @default(cuid())
  emailType         String
  recipientUsername String?
  recipientEmail    String
  status            SystemEmailActivityStatus
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([recipientEmail, createdAt])
}

// ---------- Capper profile & packages ----------

enum ProviderType {
  FREE
  PREMIUM
  HYBRID
}

enum DailyVolume {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum BetType {
  STRAIGHT
  PARLAY
  PROP
  TEASER
  TOTAL
}

model CapperProfile {
  id                    String       @id @default(cuid())
  userId                String       @unique
  headline              String? // short mission/tagline shown on profile
  bio                   String?
  avatarUrl             String?
  bannerUrl             String?
  specialties           String[]     @default([])
  sports                String[]     @default([]) // canonical sport keys from src/lib/sports.ts
  /// Odds API bookmaker keys the capper bets (src/lib/books.ts). Empty = all US books.
  books                 String[]     @default([])
  betTypes              BetType[]    @default([])
  dailyVolume           DailyVolume?
  writtenAnalysis       Boolean      @default(false)
  biggestBetWon         String?
  providerType          ProviderType @default(FREE)
  isLegacy              Boolean      @default(false)
  storefrontTitle       String?
  storefrontDescription String?
  storefrontEnabled     Boolean      @default(true)

  // social handles (store handle/username, not full URL)
  instagram String?
  twitter   String? // X / Twitter
  facebook  String?
  tiktok    String?
  website   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plays            Play[]
  parlays          Parlay[]
  packages         Package[]
  storeConnections StoreConnection[]
  legacyRecords    LegacyRecord[]
  packageAudits    PackageAuditEvent[]

  @@index([providerType])
}

// ---------- Store onboarding & affiliate packages (Milestone 3) ----------

enum StoreProvider {
  WINIBLE
  WHOP
}

enum StoreConnectionStatus {
  NOT_STARTED
  INSTRUCTIONS_VIEWED
  PENDING_SCL_ACCEPTANCE
  PENDING_SCL_LINK_IMPORT
  LINKS_RECEIVED
  PACKAGES_IMPORTED
  LIVE
  NEEDS_ACTION
  DISABLED
}

enum PackageImportStatus {
  NOT_STARTED
  LINKS_RECEIVED
  IMPORTED
  LIVE
}

enum StorefrontReviewAction {
  APPROVED
  MARKED_LIVE
  CHANGES_REQUESTED
  SUSPENDED
  RESTORED
  NOTES_UPDATED
  PACKAGE_SYNC
  CAPPER_CONTACTED
}

enum StorefrontMessageSender {
  ADMIN
  CAPPER
}

model StoreConnection {
  id                  String                @id @default(cuid())
  capperId            String
  provider            StoreProvider
  status              StoreConnectionStatus @default(NOT_STARTED)
  packageImportStatus PackageImportStatus   @default(NOT_STARTED)
  submittedAt         DateTime?
  acknowledgmentAt    DateTime?
  adminNotes          String?
  reviewedAt          DateTime?
  reviewedById        String?
  // Storefront workflow status fields
  affiliateAcceptedAt DateTime?
  lastImportedAt      DateTime?
  packageCount        Int                   @default(0)
  affiliatePercent    Float?
  requiresAttention   Boolean               @default(false)
  // Whop OAuth + sync — server-only tokens; never expose to the client.
  whopCompanyId       String?
  whopCompanyRoute    String?
  whopAccessToken     String?
  whopRefreshToken    String?
  whopTokenExpiresAt  DateTime?
  whopConnectedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  capper       CapperProfile           @relation(fields: [capperId], references: [id], onDelete: Cascade)
  reviewedBy   User?                   @relation("StoreConnectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  packages     Package[]
  reviewEvents StorefrontReviewEvent[]
  messages     StorefrontMessage[]

  @@unique([capperId, provider])
  @@index([status])
  @@index([provider])
  @@index([reviewedById])
  @@index([requiresAttention])
}

model StorefrontReviewEvent {
  id                String                 @id @default(cuid())
  storeConnectionId String
  action            StorefrontReviewAction
  previousStatus    StoreConnectionStatus
  newStatus         StoreConnectionStatus
  reviewedById      String
  reason            String?
  adminNotes        String?
  createdAt         DateTime               @default(now())

  storeConnection StoreConnection @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)
  reviewedBy      User            @relation("StorefrontReviewActor", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([storeConnectionId, createdAt])
  @@index([reviewedById])
}

model StorefrontMessage {
  id                String                  @id @default(cuid())
  storeConnectionId String
  senderId          String
  senderRole        StorefrontMessageSender
  body              String
  readByAdminAt     DateTime?
  readByCapperAt    DateTime?
  emailNotifiedAt   DateTime?
  createdAt         DateTime                @default(now())

  storeConnection StoreConnection @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)
  sender          User            @relation("StorefrontMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([storeConnectionId, createdAt])
  @@index([storeConnectionId, readByAdminAt])
  @@index([storeConnectionId, readByCapperAt])
}

enum BillingPeriod {
  ONE_TIME
  DAY
  WEEK
  MONTH
  SEASON
  YEAR
}

model Package {
  id                   String         @id @default(cuid())
  capperId             String
  storeConnectionId    String?
  title                String
  description          String?
  /// Free trial / intro offer microcopy shown on package cards (optional).
  promoOffer           String?
  priceCents           Int            @default(0)
  billingPeriod        BillingPeriod  @default(MONTH)
  /// How many `billingPeriod` units one term covers: 4 + DAY is a 4-day pass,
  /// 2 + WEEK a fortnight. Always 1 for ONE_TIME and SEASON, which have no count.
  billingIntervalCount Int            @default(1)
  // Provider affiliate / product destination URL — admin-owned for M3.
  checkoutUrl          String?
  affiliateProvider    StoreProvider?
  providerType         ProviderType   @default(PREMIUM)
  /// Lower numbers appear first on profile + marketplace.
  sortOrder            Int            @default(0)
  isActive             Boolean        @default(true)
  /// Whop product id (prod_…) when imported via API sync.
  externalProductId    String?
  /// Durable SCL → Whop delivery state. A pending local edit is retried by the
  /// reconciliation worker and is never overwritten by an inbound refresh.
  whopPushPendingAt    DateTime?
  whopLastPushedAt     DateTime?
  whopPushAttempts     Int            @default(0)
  whopPushLastError    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  capper             CapperProfile       @relation(fields: [capperId], references: [id], onDelete: Cascade)
  storeConnection    StoreConnection?    @relation(fields: [storeConnectionId], references: [id], onDelete: SetNull)
  trackingUrls       TrackingUrl[]
  packageAuditEvents PackageAuditEvent[]
  playLinks          PlayPackage[]
  parlayLinks        ParlayPackage[]

  @@unique([storeConnectionId, externalProductId])
  @@index([capperId])
  @@index([storeConnectionId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([externalProductId])
  @@index([whopPushPendingAt])
}

model TrackingUrl {
  id        String   @id @default(cuid())
  packageId String
  slug      String   @unique
  targetUrl String
  createdAt DateTime @default(now())

  package Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  clicks  ClickEvent[]

  @@index([packageId])
}

model ClickEvent {
  id            String   @id @default(cuid())
  trackingUrlId String
  referrer      String?
  userAgent     String?
  createdAt     DateTime @default(now())

  trackingUrl TrackingUrl @relation(fields: [trackingUrlId], references: [id], onDelete: Cascade)

  @@index([trackingUrlId])
}

// ---------- Plays, parlays & grading ----------

enum Outcome {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum GradingSource {
  AUTO
  ADMIN_OVERRIDE
  MANUAL
}

// How a pick reached SCL (C5 provenance). MANUAL = typed into the entry form;
// the IMPORTED_*/OCR values are reserved for the M2 auto-capture connectors.
enum PickSource {
  MANUAL
  IMPORTED_X
  IMPORTED_DISCORD
  IMPORTED_TELEGRAM
  SCREENSHOT_OCR
}

// Lifecycle guard (C4). DRAFT may still be edited; COMMITTED is append-only —
// outcomes change only via GradingAudit, never by mutating the Play in place.
enum PickStatus {
  DRAFT
  COMMITTED
}

// Public trust tier surfaced on the leaderboard. VERIFIED = a confirmed manual
// board selection logged pre-game. AUTO_VERIFIED is the same bar reached through
// an authorized connector. SELF_REPORTED is reserved for legacy/imported records.
enum VerificationTier {
  AUTO_VERIFIED
  VERIFIED
  SELF_REPORTED
}

model Play {
  id                   String    @id @default(cuid())
  capperId             String
  sport                String
  league               String?
  market               String
  selection            String
  oddsAmerican         Int
  /// What the capper tapped on the board (M5). Null = pre-guard rows.
  selectedOddsAmerican Int?
  /// True when the capper explicitly accepted a beyond-tolerance odds move (M5).
  oddsMovedAccepted    Boolean   @default(false)
  units                Decimal   @db.Decimal(16, 2) // 0.25–100,000,000 (enforced in Zod, see src/lib/constants.ts)
  /// Odds API bookmaker key captured at submit (src/lib/books.ts). Null = pre-book era / unknown.
  book                 String?
  outcome              Outcome   @default(PENDING)
  profitUnits          Decimal?  @db.Decimal(16, 2)
  notes                String?
  /// When false, analysis is hidden on public pick cards (dashboard always shows).
  notesPublic          Boolean   @default(true)
  /// Last same-book American price at/before event start (CLV v1).
  closingOddsAmerican  Int?
  clvPts               Decimal?  @db.Decimal(10, 4)
  closingCapturedAt    DateTime?
  /// Extreme American price at submit (≥+900 / ≤−2000) — allow but flag for admin review.
  needsReview          Boolean   @default(false)
  parlayId             String?
  createdAt            DateTime  @default(now())
  gradedAt             DateTime?

  // Pick integrity (docs/SCL_PICK_INTEGRITY.md) — all additive + defaulted so existing rows
  // and existing reads are unaffected. Populated by createPlay on the event-bound path.
  eventId          String? // official schedule/odds event id (C2 event binding)
  eventLabel       String? // human-readable matchup captured with the board event
  // The fixture this play belongs to, when no eventId binds it. Legacy imports
  // carry Home/Away in the source rows; without them a bare "Over 7 total" can
  // never be matched to a game and stays PENDING forever.
  homeTeam         String?
  awayTeam         String?
  eventStartsAt    DateTime? // scheduled first pitch/tip; drives the C1 pre-game lock
  loggedPreGame    Boolean          @default(false) // createdAt < eventStartsAt (C1)
  line             Decimal?         @db.Decimal(10, 2) // structured point/total (C2)
  side             String? // structured side: team, Over/Under (C2)
  source           PickSource       @default(MANUAL) // provenance (C5)
  sourceRef        String? // permalink to the originating post, when imported (C5)
  oddsVerified     Boolean          @default(false) // confirmed board price or connector-authenticated price (C3)
  verificationTier VerificationTier @default(SELF_REPORTED) // public trust tier (M2-3)
  status           PickStatus       @default(COMMITTED) // DRAFT is editable; COMMITTED is locked (C4)

  capper       CapperProfile  @relation(fields: [capperId], references: [id], onDelete: Cascade)
  parlay       Parlay?        @relation(fields: [parlayId], references: [id], onDelete: SetNull)
  audits       GradingAudit[]
  packageLinks PlayPackage[]

  @@index([capperId])
  @@index([outcome])
  @@index([eventId])
  @@index([status, createdAt])
}

model Parlay {
  id                   String    @id @default(cuid())
  capperId             String
  combinedOddsAmerican Int?
  units                Decimal   @db.Decimal(16, 2)
  outcome              Outcome   @default(PENDING)
  profitUnits          Decimal?  @db.Decimal(16, 2)
  createdAt            DateTime  @default(now())
  gradedAt             DateTime?

  capper       CapperProfile        @relation(fields: [capperId], references: [id], onDelete: Cascade)
  legs         Play[]
  audits       ParlayGradingAudit[]
  packageLinks ParlayPackage[]

  @@index([capperId])
}

/// Immutable attribution between a straight pick and the offers it was sold in.
model PlayPackage {
  playId    String
  packageId String
  createdAt DateTime @default(now())

  play    Play    @relation(fields: [playId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([playId, packageId])
  @@index([packageId, createdAt])
}

/// Immutable attribution between a parlay and the offers it was sold in.
model ParlayPackage {
  parlayId  String
  packageId String
  createdAt DateTime @default(now())

  parlay  Parlay  @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([parlayId, packageId])
  @@index([packageId, createdAt])
}

/// Daily Odds API credit usage rollup (purpose + sport scoped).
model OddsUsageDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  purpose   String
  sport     String   @default("")
  calls     Int      @default(0)
  credits   Int      @default(0)
  remaining Int?
  capacity  Int?
  updatedAt DateTime @updatedAt

  @@unique([date, purpose, sport])
  @@index([date])
}

/// Exact response-level Odds API usage attributed to requested market keys.
model OddsUsageMarketDaily {
  id      String   @id @default(cuid())
  date    DateTime @db.Date
  purpose String
  sport   String   @default("")
  market  String
  calls   Int      @default(0)
  credits Int      @default(0)

  @@unique([date, purpose, sport, market])
  @@index([date])
  @@index([sport, date])
}

/// Owner-managed limits and the rollout switch for database-driven odds scheduling.
model OddsControlConfig {
  id                               String   @id @default("primary")
  managedSchedulingEnabled         Boolean  @default(false)
  paused                           Boolean  @default(false)
  dailyCreditLimit                 Int      @default(2000)
  weeklyCreditLimit                Int      @default(10000)
  monthlyCreditLimit               Int      @default(20000)
  perRunCreditLimit                Int      @default(2000)
  warningPercent                   Int      @default(70)
  reserveCredits                   Int      @default(1000)
  verificationEnabled              Boolean  @default(true)
  verificationDailyRequestLimit    Int      @default(250)
  verificationDailyCreditLimit     Int      @default(500)
  verificationMaxCreditsPerRequest Int      @default(20)
  verificationCacheMinutes         Int      @default(30)
  timezone                         String   @default("America/New_York")
  updatedById                      String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  updatedBy User? @relation("OddsControlUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Per-sport owner strategy. Market keys are validated against SCL's supported registry.
model OddsSportControl {
  id                     String    @id @default(cuid())
  sport                  String    @unique
  enabled                Boolean   @default(true)
  surfaceEnabled         Boolean   @default(true)
  expandedEnabled        Boolean   @default(false)
  surfaceMarkets         String[]  @default(["h2h", "spreads", "totals"])
  expandedMarkets        String[]  @default([])
  leagues                String[]  @default([])
  surfaceCadenceMinutes  Int       @default(240)
  expandedCadenceMinutes Int       @default(360)
  maxEventsPerRun        Int       @default(20)
  nextSurfaceRunAt       DateTime?
  nextExpandedRunAt      DateTime?
  lastSurfaceRunAt       DateTime?
  lastExpandedRunAt      DateTime?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  updatedBy User? @relation("OddsSportControlUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled, nextSurfaceRunAt])
  @@index([enabled, nextExpandedRunAt])
}

/// One provider population attempt, including its reservation and actual cost.
model OddsApiRun {
  id               String    @id @default(cuid())
  sport            String
  tier             String
  trigger          String
  status           String
  estimatedCredits Int       @default(0)
  reservedCredits  Int       @default(0)
  credits          Int       @default(0)
  remaining        Int?
  markets          String[]  @default([])
  leagues          String[]  @default([])
  details          Json?
  error            String?
  triggeredById    String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  triggeredBy User? @relation("OddsApiRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([sport, startedAt])
  @@index([status, startedAt])
}

/// Append-only owner change history for limits, markets, leagues, and cadence.
model OddsControlAuditEvent {
  id        String   @id @default(cuid())
  action    String
  target    String
  before    Json?
  after     Json?
  actorId   String?
  createdAt DateTime @default(now())

  actor User? @relation("OddsControlAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Deployment-independent last-good odds snapshots used by the pick maker.
model OddsCacheSnapshot {
  key       String   @id
  payload   Json
  savedAt   DateTime
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model GradingAudit {
  id                  String        @id @default(cuid())
  playId              String
  previousOutcome     Outcome
  newOutcome          Outcome
  previousProfitUnits Decimal?      @db.Decimal(16, 2)
  newProfitUnits      Decimal?      @db.Decimal(16, 2)
  source              GradingSource
  gradedById          String?
  reason              String?
  createdAt           DateTime      @default(now())

  play     Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  gradedBy User? @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([playId])
}

model ParlayGradingAudit {
  id                  String        @id @default(cuid())
  parlayId            String
  previousOutcome     Outcome
  newOutcome          Outcome
  previousProfitUnits Decimal?      @db.Decimal(16, 2)
  newProfitUnits      Decimal?      @db.Decimal(16, 2)
  source              GradingSource
  gradedById          String?
  reason              String?
  createdAt           DateTime      @default(now())

  parlay   Parlay @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  gradedBy User?  @relation("ParlayGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([parlayId, createdAt])
  @@index([gradedById])
}

model GradeJobRun {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  provider        String
  graded          Int       @default(0)
  skipped         Int       @default(0)
  parlaysGraded   Int       @default(0)
  skippedByReason Json
  status          String // RUNNING | SUCCESS | FAILED
  error           String?
  meta            Json?

  @@index([status])
  @@index([createdAt])
}

/// Aggregate results carried over from the previous SCL platform
/// (sportscappersleaderboard.com), which pruned individual picks on a rolling
/// 90-day basis and kept only these summary totals beyond that. There is no
/// pick-level evidence behind them, so they are stored separately from `Play`
/// and always surfaced with explicit legacy provenance.
enum LegacyRecordScope {
  /// The leaderboard baseline: the capper's legacy calendar-year total MINUS the plays
  /// that were imported as real `Play` rows. Adding this to computed stats
  /// reproduces the legacy year-to-date total exactly, with no window double-counting.
  PRE_IMPORT
  CURRENT_SEASON
  CURRENT_YEAR
  YEAR_2025
  SEASON_2025
  /// Mapped to the legacy `y2024` / `s2024` / `stats_post` tables, which are
  /// EMPTY in every export to date: one scaffolding row per capper with the
  /// name filled and every counter at zero, 0 settled results between them.
  /// No row carries these scopes. They are declared because the values already
  /// exist in the production enum and Postgres cannot drop one — so leaving
  /// them out means permanent schema drift. Display-only if they ever populate:
  /// PRE_IMPORT is the only scope standings fold in.
  YEAR_2024
  SEASON_2024
  POSTSEASON
  LAST_7D
  LAST_30D
  LAST_60D
  LAST_90D
}

model LegacyRecord {
  id       String            @id @default(cuid())
  capperId String
  scope    LegacyRecordScope
  /// A canonical SPORT_KEY, or "ALL" for the combined total. A sentinel rather
  /// than null so the uniqueness constraint actually holds (Postgres treats
  /// NULLs as distinct, which would allow duplicate combined-total rows).
  sport    String

  wins        Int     @default(0)
  losses      Int     @default(0)
  pushes      Int     @default(0)
  /// Units risked, matching the legacy platform's risk-denominated convention
  /// (a favorite lays juice to win one unit), so ROI = unitsNet / unitsRisked.
  unitsRisked Decimal @db.Decimal(12, 2)
  unitsNet    Decimal @db.Decimal(12, 2)

  /// When the legacy export these totals came from was taken.
  capturedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  capper CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)

  @@unique([capperId, scope, sport])
  @@index([scope, sport])
}

/// Append-only record of administrator changes to a capper's packages.
///
/// Storefront transitions are audited through `StorefrontReviewEvent`, but that
/// requires a `storeConnectionId` and records a status change — it cannot cover
/// package edits, and cannot cover packages with no connection at all (every
/// offer carried over from the previous platform). Package price, title and
/// visibility are revenue-affecting and publicly visible, so they need
/// attribution of their own.
enum PackageAuditAction {
  CREATED
  UPDATED
  ACTIVATED
  DEACTIVATED
  REORDERED
  DELETED
}

model PackageAuditEvent {
  id        String             @id @default(cuid())
  /// Nulled rather than cascaded when a package is deleted: the point of an
  /// audit trail is that it outlives the thing it describes.
  packageId String?
  /// Kept independently so a capper's history survives package deletion.
  capperId  String
  action    PackageAuditAction
  actorId   String
  /// What actually changed, in words — "price 25.00 -> 40.00", "hidden".
  summary   String?
  createdAt DateTime           @default(now())

  package Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  capper  CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  actor   User          @relation("PackageAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([capperId, createdAt])
  @@index([packageId])
  @@index([actorId])
}

enum BroadcastAudience {
  ALL_CAPPERS
  VERIFIED_CAPPERS
  SINGLE_CAPPER
}

/// One admin send: the roster, a filtered slice of it, or a single capper.
/// Kept as a record because "did we tell them?" is a question that gets asked
/// after the fact, and a mail provider's dashboard is not part of the product.
model AdminBroadcast {
  id             String                    @id @default(cuid())
  subject        String
  body           String
  audience       BroadcastAudience
  sentById       String
  sentBy         User                      @relation("AdminBroadcastSender", fields: [sentById], references: [id], onDelete: Cascade)
  recipientCount Int                       @default(0)
  deliveredCount Int                       @default(0)
  failedCount    Int                       @default(0)
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?
  recipients     AdminBroadcastRecipient[]

  @@index([createdAt])
}

/// Per-recipient outcome, so "did this capper get it?" is answerable.
model AdminBroadcastRecipient {
  id          String         @id @default(cuid())
  broadcastId String
  broadcast   AdminBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?          @relation("AdminBroadcastRecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  address     String
  delivered   Boolean        @default(false)
  error       String?
  createdAt   DateTime       @default(now())

  @@index([broadcastId])
  @@index([userId])
}
