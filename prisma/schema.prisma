// SCL Phase 1 — foundational schema
// Stack: PostgreSQL + Prisma. Models cover auth, cappers, plays, parlays,
// packages, tracking, and grading. Built to be extended per feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (Auth.js / NextAuth) ----------

enum Role {
  CAPPER
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String?       @unique
  passwordHash  String?
  displayName   String?
  role          Role          @default(CAPPER)
  accountStatus AccountStatus @default(ACTIVE)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts           Account[]
  sessions           Session[]
  capperProfile      CapperProfile?
  customerProfile    CustomerProfile?
  termsAcceptances   TermsAcceptance[]
  gradingActions     GradingAudit[]       @relation("GradedBy")
  passwordResetToken PasswordResetToken?
  statusChanges      AccountStatusAudit[] @relation("AccountStatusSubject")
  statusActions      AccountStatusAudit[] @relation("AccountStatusActor")
  storefrontReviews  CapperProfile[]      @relation("StorefrontReviewedBy")
  packageApprovals   Package[]            @relation("PackageApprovedBy")
  policyReleases     PolicyRelease[]      @relation("PolicyPublishedBy")
  bulkEmailCampaigns BulkEmailCampaign[]  @relation("BulkEmailSentBy")
  recordedSales      PackageSale[]        @relation("SaleRecordedBy")
  customerPurchases  PackageSale[]        @relation("CustomerPurchases")
  clickEvents        ClickEvent[]
  commerceSettings   PlatformCommerceSettings[] @relation("CommerceSettingsUpdatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id            String   @id @default(cuid())
  userId        String
  policyVersion String
  acceptedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountStatusAudit {
  id             String        @id @default(cuid())
  userId         String
  previousStatus AccountStatus
  newStatus      AccountStatus
  changedById    String
  reason         String?
  createdAt      DateTime      @default(now())

  user      User @relation("AccountStatusSubject", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User @relation("AccountStatusActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([changedById])
}

model RequestThrottle {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

// ---------- Capper profile & packages ----------

enum ProviderType {
  FREE
  PREMIUM
  HYBRID
}

enum DailyVolume {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum CommercePlatform {
  NONE
  WINIBLE
  WHOP
}

enum StorefrontStatus {
  NOT_STARTED
  AWAITING_AFFILIATE_INVITE
  PENDING_SCL_REVIEW
  APPROVED
  STOREFRONT_LIVE
  NEEDS_ATTENTION
}

enum PackageVisibility {
  DRAFT
  HIDDEN
  LIVE
}

enum BetType {
  STRAIGHT
  PARLAY
  PROP
  TEASER
  TOTAL
}

model CapperProfile {
  id                    String       @id @default(cuid())
  userId                String       @unique
  headline              String? // short mission/tagline shown on profile
  bio                   String?
  avatarUrl             String?
  bannerUrl             String?
  specialties           String[]     @default([])
  sports                String[]     @default([]) // canonical sport keys from src/lib/sports.ts
  /// Odds API bookmaker keys the capper bets (src/lib/books.ts). Empty = all US books.
  books                 String[]     @default([])
  betTypes              BetType[]    @default([])
  dailyVolume           DailyVolume?
  writtenAnalysis       Boolean      @default(false)
  biggestBetWon         String?
  providerType          ProviderType @default(FREE)
  isLegacy              Boolean      @default(false)
  storefrontTitle       String?
  storefrontDescription String?
  storefrontEnabled     Boolean            @default(true)
  commercePlatform      CommercePlatform   @default(NONE)
  storefrontStatus      StorefrontStatus   @default(NOT_STARTED)
  adminNotes            String?
  lastReviewedAt        DateTime?
  lastReviewedById      String?
  nativeStoreEnabled    Boolean            @default(false)
  defaultAffiliatePercent Int?

  // social handles (store handle/username, not full URL)
  instagram String?
  twitter   String? // X / Twitter
  facebook  String?
  tiktok    String?
  website   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReviewedBy User?     @relation("StorefrontReviewedBy", fields: [lastReviewedById], references: [id], onDelete: SetNull)
  plays          Play[]
  parlays  Parlay[]
  packages Package[]

  @@index([providerType])
}

enum BillingPeriod {
  ONE_TIME
  DAY
  WEEK
  MONTH
  SEASON
  YEAR
}

model Package {
  id            String        @id @default(cuid())
  capperId      String
  title         String
  description   String?
  priceCents    Int           @default(0)
  billingPeriod BillingPeriod @default(MONTH)
  // External checkout (e.g. Winible) for Phase 1; native Stripe checkout in Phase 2.
  checkoutUrl   String?
  trialTerms    String?
  displayOrder  Int               @default(0)
  visibility    PackageVisibility @default(DRAFT)
  affiliatePercent Int?
  approvedAt    DateTime?
  approvedById  String?
  suspendedAt   DateTime?
  suspendedReason String?
  providerType  ProviderType  @default(PREMIUM)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  capper       CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  approvedBy   User?         @relation("PackageApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  trackingUrls TrackingUrl[]
  sales        PackageSale[]

  @@index([capperId])
  @@index([visibility])
}

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  marketingOptIn Boolean  @default(true)
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases PackageSale[]

  @@index([marketingOptIn])
}

model TrackingUrl {
  id        String   @id @default(cuid())
  packageId String
  slug      String   @unique
  targetUrl String
  createdAt DateTime @default(now())

  package Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  clicks  ClickEvent[]

  @@index([packageId])
}

model ClickEvent {
  id             String   @id @default(cuid())
  trackingUrlId  String
  customerUserId String?
  referrer       String?
  userAgent      String?
  createdAt      DateTime @default(now())

  trackingUrl  TrackingUrl    @relation(fields: [trackingUrlId], references: [id], onDelete: Cascade)
  customerUser User?          @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  sales        PackageSale[]

  @@index([trackingUrlId])
  @@index([customerUserId])
}

// ---------- Plays, parlays & grading ----------

enum Outcome {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum GradingSource {
  AUTO
  ADMIN_OVERRIDE
  MANUAL
}

// How a pick reached SCL (C5 provenance). MANUAL = typed into the entry form;
// the IMPORTED_*/OCR values are reserved for the M2 auto-capture connectors.
enum PickSource {
  MANUAL
  IMPORTED_X
  IMPORTED_DISCORD
  IMPORTED_TELEGRAM
  SCREENSHOT_OCR
}

// Lifecycle guard (C4). DRAFT may still be edited; COMMITTED is append-only —
// outcomes change only via GradingAudit, never by mutating the Play in place.
enum PickStatus {
  DRAFT
  COMMITTED
}

// Public trust tier surfaced on the leaderboard. VERIFIED = event-bound, logged
// pre-game, and claimed odds within tolerance of the market. AUTO_VERIFIED is the
// same bar reached through an authorized connector. SELF_REPORTED = everything else.
enum VerificationTier {
  AUTO_VERIFIED
  VERIFIED
  SELF_REPORTED
}

model Play {
  id           String    @id @default(cuid())
  capperId     String
  sport        String
  league       String?
  market       String
  selection    String
  oddsAmerican Int
  /// What the capper tapped on the board (M5). Null = pre-guard rows.
  selectedOddsAmerican Int?
  /// True when the capper explicitly accepted a beyond-tolerance odds move (M5).
  oddsMovedAccepted Boolean @default(false)
  units        Decimal   @db.Decimal(10, 2) // standardized range 0.25–5 (enforced in Zod, see src/lib/constants.ts)
  /// Odds API bookmaker key captured at submit (src/lib/books.ts). Null = pre-book era / unknown.
  book         String?
  outcome      Outcome   @default(PENDING)
  profitUnits  Decimal?  @db.Decimal(10, 2)
  notes        String?
  parlayId     String?
  createdAt    DateTime  @default(now())
  gradedAt     DateTime?

  // Pick integrity (docs/SCL_PICK_INTEGRITY.md) — all additive + defaulted so existing rows
  // and existing reads are unaffected. Populated by createPlay on the event-bound path.
  eventId          String? // official schedule/odds event id (C2 event binding)
  eventStartsAt    DateTime? // scheduled first pitch/tip; drives the C1 pre-game lock
  loggedPreGame    Boolean          @default(false) // createdAt < eventStartsAt (C1)
  line             Decimal?         @db.Decimal(10, 2) // structured point/total (C2)
  side             String? // structured side: team, Over/Under (C2)
  source           PickSource       @default(MANUAL) // provenance (C5)
  sourceRef        String? // permalink to the originating post, when imported (C5)
  oddsVerified     Boolean          @default(false) // claimed price within tolerance (C3)
  verificationTier VerificationTier @default(SELF_REPORTED) // public trust tier (M2-3)
  status           PickStatus       @default(COMMITTED) // DRAFT is editable; COMMITTED is locked (C4)

  capper CapperProfile  @relation(fields: [capperId], references: [id], onDelete: Cascade)
  parlay Parlay?        @relation(fields: [parlayId], references: [id], onDelete: SetNull)
  audits GradingAudit[]

  @@index([capperId])
  @@index([outcome])
  @@index([eventId])
}

model Parlay {
  id                   String    @id @default(cuid())
  capperId             String
  combinedOddsAmerican Int?
  units                Decimal   @db.Decimal(10, 2)
  outcome              Outcome   @default(PENDING)
  profitUnits          Decimal?  @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())
  gradedAt             DateTime?

  capper CapperProfile @relation(fields: [capperId], references: [id], onDelete: Cascade)
  legs   Play[]

  @@index([capperId])
}

model GradingAudit {
  id              String        @id @default(cuid())
  playId          String
  previousOutcome Outcome
  newOutcome      Outcome
  source          GradingSource
  gradedById      String?
  reason          String?
  createdAt       DateTime      @default(now())

  play     Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  gradedBy User? @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([playId])
}

// ---------- Policy CMS & admin communications ----------

enum PolicyDocumentSlug {
  TERMS
  PRIVACY
  RESPONSIBLE_GAMING
  DISCLAIMER
}

enum BulkEmailAudience {
  ALL_CAPPERS
  ACTIVE_CAPPERS
  VERIFIED_CAPPERS
  STOREFRONT_LIVE
  NEEDS_ATTENTION
  ALL_CUSTOMERS
  ACTIVE_CUSTOMERS
  MARKETING_OPT_IN_CUSTOMERS
}

enum EmailRecipientKind {
  CAPPER
  CUSTOMER
}

enum SaleSource {
  MANUAL
  WINIBLE
  WHOP
  SCL_NATIVE
}

enum SaleStatus {
  REPORTED
  CONFIRMED
  REFUNDED
  DISPUTED
}

model PolicyRelease {
  id                   String   @id @default(cuid())
  version              String   @unique
  summary              String?
  requiresReacceptance Boolean  @default(true)
  publishedAt          DateTime @default(now())
  publishedById        String

  publishedBy User              @relation("PolicyPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  documents   PolicyDocument[]

  @@index([publishedAt])
}

model PolicyDocument {
  id        String             @id @default(cuid())
  releaseId String
  slug      PolicyDocumentSlug
  title     String
  body      String             @db.Text

  release PolicyRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, slug])
  @@index([slug])
}

model BulkEmailCampaign {
  id              String             @id @default(cuid())
  subject         String
  bodyHtml        String             @db.Text
  recipientKind   EmailRecipientKind @default(CAPPER)
  audience        BulkEmailAudience
  recipientCount  Int                @default(0)
  deliveredCount  Int                @default(0)
  failedCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  sentById        String

  sentBy User @relation("BulkEmailSentBy", fields: [sentById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([recipientKind])
}

model PlatformCommerceSettings {
  id                       String   @id @default("default")
  nativeStoreEnabled       Boolean  @default(false)
  platformAffiliatePercent Int      @default(20)
  updatedAt                DateTime @updatedAt
  updatedById              String?

  updatedBy User? @relation("CommerceSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PackageSale {
  id               String     @id @default(cuid())
  packageId        String
  customerUserId   String?
  customerProfileId String?
  clickEventId     String?
  source           SaleSource
  status           SaleStatus @default(REPORTED)
  grossCents       Int
  affiliateCents   Int?
  affiliatePercent Int?
  externalOrderId  String?
  purchasedAt      DateTime
  notes            String?
  recordedById     String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  package         Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  customerUser    User?            @relation("CustomerPurchases", fields: [customerUserId], references: [id], onDelete: SetNull)
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  clickEvent      ClickEvent?      @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  recordedBy      User             @relation("SaleRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([purchasedAt])
  @@index([status])
  @@index([source])
}
