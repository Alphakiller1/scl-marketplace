{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=99&expandedDays=today&surface=1&skipPopulated=1&expandedMaxAgeMinutes=120",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=99&expandedDays=today&surface=1&skipPopulated=1&expandedMaxAgeMinutes=120",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=99&expandedDays=today&surface=1&skipPopulated=1&expandedMaxAgeMinutes=120",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=99&expandedDays=today&surface=1&skipPopulated=1&expandedMaxAgeMinutes=120",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=0&surface=1",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL&expanded=99&expandedDays=today,tomorrow&surface=1&skipPopulated=1&expandedMaxAgeMinutes=120",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/whop-sync",
      "schedule": "*/5 * * * *"
    }
  ]
}
