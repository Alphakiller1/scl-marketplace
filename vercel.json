{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL,NCAAF,MMA,CFL&expanded=99&surface=1&skipPopulated=1&expandedMaxAgeMinutes=330&expandedDays=today,tomorrow",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL,NCAAF,MMA,CFL&expanded=99&surface=1&skipPopulated=1&expandedMaxAgeMinutes=330&expandedDays=today,tomorrow",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL,NCAAF,MMA,CFL&expanded=0&surface=1",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL,NCAAF,MMA,CFL&expanded=99&surface=1&skipPopulated=1&expandedMaxAgeMinutes=330&expandedDays=today,tomorrow",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/odds-populate?sports=MLB,WNBA,TENNIS,SOCCER,NFL,NCAAF,MMA,CFL&expanded=99&surface=0&skipPopulated=1&expandedMaxAgeMinutes=330&expandedDays=today,tomorrow",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/odds-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/whop-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-automations",
      "schedule": "17 * * * *"
    }
  ]
}
