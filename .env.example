# Database (PostgreSQL) - Supabase/Neon/local.
# SCL is isolated in its own scl schema (keep ?schema=scl).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Email verification and password recovery
EMAIL_FROM="no-reply@scl.local"
RESEND_API_KEY=""

# Supabase Storage (server-only) — required for avatar/cover uploads on
# /dashboard/profile. Without SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY the
# upload action returns "Profile media uploads are not configured yet."
# Set the same vars in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Bucket is auto-created as a public store on first use.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROFILE_MEDIA_BUCKET="scl-profile-media"

# The Odds API (odds assist + automated grading)
ODDS_API_KEY=""

# Vercel Cron auth for /api/cron/grade (Bearer token). Leave empty locally;
# production should set a strong secret. Vercel cron also sends x-vercel-cron.
CRON_SECRET=""

# Isolated preview QA only. Never set on Vercel Production. When set to 1 on
# a Preview deployment, reserved @ghost.scl.demo accounts may populate public
# surfaces for visual testing; production remains fail-closed.
SCL_ALLOW_GHOST_PUBLICATION="0"
