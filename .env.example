# Database (PostgreSQL) - Supabase/Neon/local.
# SCL is isolated in its own scl schema (keep ?schema=scl).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Email verification and password recovery
EMAIL_FROM="no-reply@scl.local"
RESEND_API_KEY=""

# Supabase Storage (server-only) — required for avatar/cover uploads on
# /dashboard/profile. Without SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY the
# upload action returns "Profile media uploads are not configured yet."
# Set the same vars in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Bucket is auto-created as a public store on first use.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROFILE_MEDIA_BUCKET="scl-profile-media"

# The Odds API (odds assist + automated grading)
ODDS_API_KEY=""

# Vercel Cron auth for /api/cron/grade (Bearer token). Leave empty locally;
# production should set a strong secret. Vercel cron also sends x-vercel-cron.
CRON_SECRET=""

# Feature flags (enabled by setting to "true")
FEATURE_ADMIN_STOREFRONT_WORKFLOW=""

# Temporary demo populate. Reserved @ghost.scl.demo accounts appear on public
# surfaces unless this is set to 0. Seed production with:
#   GHOST_SEED=1 GHOST_SEED_FORCE=1 npm run seed:ghosts
# against the production DATABASE_URL. Set to 0 and wipe ghosts when ready.
# Set to "1" ONLY to publish fabricated @ghost.scl.demo cappers on public
# surfaces. Opt-in on purpose: the default must never be to show invented
# records on a board labelled verified.
SCL_ALLOW_GHOST_PUBLICATION=""
# Results provider for auto-grading cron (default = TheSportsDB free tier)
RESULTS_PROVIDER=""

# Whop webhook signing secret (Whop dashboard > your App > Webhooks).
# Unset means the webhook route rejects every delivery with 503 — it fails closed.
WHOP_WEBHOOK_SECRET=""
# Whop App API key — server-side only, needed for the products sync that turns
# webhook events into Package rows. Never expose this to the browser.
WHOP_API_KEY=""
# Whop App ID. NEXT_PUBLIC_ because the embedded checkout/app SDK reads it in the
# browser; it is a public identifier, unlike the two secrets above.
NEXT_PUBLIC_WHOP_APP_ID=""
