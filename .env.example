# Database (PostgreSQL) - Supabase/Neon/local.
# SCL is isolated in its own scl schema (keep ?schema=scl).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=scl"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Canonical public origin for robots.txt / sitemap.xml. Set this in production
# to the real domain, otherwise those files advertise the *.vercel.app host as
# canonical. Falls back to VERCEL_PROJECT_PRODUCTION_URL, then the deploy host.
NEXT_PUBLIC_SITE_URL=""

# Email verification, password recovery, and support form delivery.
# Production EMAIL_FROM must use a domain verified by Resend, and that domain
# must be SCL's own — cappers read the "from" line, and mail arriving from an
# unrelated company reads as a phish. /api/health reports `email.matchesSite`
# so a sender left pointing elsewhere is visible instead of silent.
# The `Name <address>` form is supported and preferred in production
# (`SCL <no-reply@sportscappersleaderboard.com>`) — the name is the half an
# inbox actually renders, so /api/health reports `email.displayName` too: a
# domain check cannot tell whose brand is on the message.
# RESEND_API_KEY decides *which account* sends. It must be SCL's own, not an
# individual's: production mail on a personal account can stop without warning
# and without anyone at SCL able to see why. See docs/SCL_DEPLOYMENT.md.
EMAIL_FROM="no-reply@scl.local"
RESEND_API_KEY=""
# Also used as the Reply-To on verification/reset/claim mail, which is otherwise
# sent from an unmonitored no-reply@.
SUPPORT_EMAIL_TO="support@scl.com"
# Comma-separated mailbox(es) for admin alerts (new signups, affiliate
# signups, storefront messages).
# Defaults to SUPPORT_EMAIL_TO, then scleaderboard@gmail.com.
ADMIN_NOTIFICATION_EMAIL_TO="scleaderboard@gmail.com"

# Supabase Storage (server-only) — required for avatar/cover uploads on
# /dashboard/profile. Without SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY the
# upload action returns "Profile media uploads are not configured yet."
# SCL also accepts Supabase Vercel integration aliases: SUPABASE_SECRET_KEY,
# NEXT_PUBLIC_SUPABASE_URL, POSTGRES_* (see docs/SUPABASE_VERCEL_ENV_SYNC.md).
# Set the same vars in Vercel → Project → Settings → Environment Variables
# (Production + Preview), or use Actions → Sync Supabase env to Vercel.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROFILE_MEDIA_BUCKET="scl-profile-media"

# The Odds API (odds assist + automated grading)
ODDS_API_KEY=""

# Vercel Cron auth for /api/cron/grade (Bearer token). Leave empty locally;
# production should set a strong secret. Vercel cron also sends x-vercel-cron.
CRON_SECRET=""

# Feature flags (enabled by setting to "true")
FEATURE_ADMIN_STOREFRONT_WORKFLOW=""

# Temporary demo populate. Reserved @ghost.scl.demo accounts stay private
# unless publication is explicitly enabled. Seed a non-production database with:
#   GHOST_SEED=1 GHOST_SEED_FORCE=1 npm run seed:ghosts
# Set to "1" ONLY to publish fabricated @ghost.scl.demo cappers on public
# surfaces. Opt-in on purpose: the default must never be to show invented
# records on a board labelled verified.
SCL_ALLOW_GHOST_PUBLICATION=""
# Results provider for auto-grading cron (default = TheSportsDB free tier)
RESULTS_PROVIDER=""

# Whop integration — see docs/WHOP_API_SETUP_OWNER_GUIDE.md
# Webhook signing secret (Whop dashboard > Developer > Webhooks, API version v1).
# Unset means POST /api/webhooks/whop rejects every delivery with 503.
WHOP_WEBHOOK_SECRET=""
# SCL Account API key — server-side only; used for affiliate/payment reads on SCL's business.
WHOP_API_KEY=""
# Whop App credentials — capper app-install OAuth + future product sync.
# NEXT_PUBLIC_ prefix is required for the browser-side app id; WHOP_APP_ID is an alias.
NEXT_PUBLIC_WHOP_APP_ID=""
WHOP_APP_ID=""
WHOP_APP_API_KEY=""
# SCL's affiliate username on Whop checkout links (?a=). Required for admin link validation.
WHOP_AFFILIATE_USERNAME=""
