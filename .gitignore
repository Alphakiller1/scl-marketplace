# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Legacy capper import data (real exports — keep out of git; .example.json is tracked)
prisma/legacy-cappers.json
prisma/legacy-records.json

# Local visual QA artifacts (do not commit)
qa-screenshots*/

# Local dev toolchain (portable node, etc. — never commit)
.tools/


tmp/

